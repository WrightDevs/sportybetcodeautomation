# must match the site you bet on: gh or ng
REGION=gh

# in-play live endpoint
LIVE_ENDPOINT=inplayEvents

# comma-separated sportIds. real football = sr:sport:1
# virtual football = sr:sport:202120001 (vFootball), sr:sport:137 (eFootball)
SPORTS=sr:sport:1

# only legs near-certain by market shape (virtual mode)
SURE_ONLY=true

# how many minutes ahead to accept virtual fixtures
VIRTUAL_WINDOW_MIN=25

# league diversity cap for virtual mode (few leagues, so high)
VIRTUAL_LEAGUE_CAP=40

# telegram delivery
TG_TOKEN=
TG_CHAT=

# Admin / Owner Telegram IDs (comma-separated, permanent free access & unlimited Quest Special)
ADMIN_ID=
ADMIN_IDS=6916043986,5436260273

# VIP Subscription Settings (1k weekly)
SUB_PRICE=1000
SUB_DAYS=7

# QuestPay v1 API Configuration
QUESTPAY_API_KEY=
QUESTPAY_API_URL=https://payments-api.questlabs.cc/api
QUESTPAY_LINK=
WEBHOOK_PORT=3000

# Manual Bank Transfer Details
BANK_NAME=OPay
ACCOUNT_NUMBER=1234567890
ACCOUNT_NAME=Your Name

# llm re-ranking — leave LLM_KEY empty to skip entirely
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.0-flash
LLM_KEY=

# 5DollarFootballAPI (Verified stats & standings)
FOOTBALL_API_KEY=fb_live_dodIMepwcojrYqipEWI3NI8NPGXJWhNa
FOOTBALL_API_BASE=https://api.5dollarfootballapi.com/v1
FOOTBALL_API_CACHE_TTL_MS=10800000

# target combined odds (set to 10 for safest ~10 odds ticket, or 0 for 50-leg chunks)
TARGET_ODDS=10

# odds band per leg
MIN_ODDS=1.05
MAX_ODDS=1.15

# volume
TARGET=150
LEGS_PER_CODE=50
MAX_CODES=1
GAP_MS=90000
LEAGUE_CAP=6

USE_LLM=true

# ── Quest Special safe selector (all optional; defaults shown) ──
# SEL_WINDOW_HT=40            effective playing time for half-time markets
# SEL_WINDOW_FT=80            effective playing time for full-time markets
# SEL_TIME_SCALING=on         off = use the raw clock (no END/W safety scaling)
# SEL_MIN_LEG_PROB=0.78       min de-vigged, coherence-checked leg probability
# SEL_MIN_LEG_ODDS=1.10
# SEL_MAX_LEG_ODDS=1.35       defaults to QUEST_MAX_ODDS
# SEL_MIN_SLIP_PROB=0.45      min joint probability; below it => "no safe slip"
# SEL_COHERENCE_TOL=0.10      max |model - market| probability gap
# SEL_MIN_WIN_PROB=0.85       straight 1X2 legs need at least this
# SEL_MIN_FALLBACK_PROB=0.85  No GG / Under / result legs need at least this (handicap uses SEL_MIN_LEG_PROB)
# SEL_PREFER_HANDICAP=on      off = rank all markets purely by safety score
# SEL_HCP_LINE_ORDER=3,4,5,2,1   preferred handicap line (head start of the backed team), best first; +3 before +2; Double Chance (+0.5) last
# SEL_VETO_TIMEOUT_MS=2000    LLM veto budget (multi-leg only, fail-open)

# ── Normal football safe selector (all optional; defaults shown) ──
# Fits a goal model per match to the de-vigged 1X2 + totals ladder; leg prob = min(model, market).
# FB_LEGACY=off               on = old lowest-odds scan (no probabilities)
# FB_HORIZON_HOURS=18         FB_MIN_LEAD_MIN=15
# FB_MIN_ODDS=1.03            FB_MAX_ODDS=1.30
# FB_COHERENCE_TOL=0.07       FB_MAX_FIT_RMSE=0.05
# FB_ALLOW_DC_12=off          "Home or Away" Double Chance excluded unless on
# FB_MIN_WIN_PROB=0.90        FB_MIN_FALLBACK_PROB=0.88   (No GG / Under / straight win)
# FB_MIN_UNDER_LINE=3.5       FB_MAX_MOVE=0.05  (drop leg if odds moved >5% before minting)
# FB_LEAGUE_CAP=2
# FB_MAX_LEGS=50             hard cap on legs per slip (every tier)
# FB_ROOKIE_LEGS=4  FB_ROOKIE_MIN_PROB=0.90  FB_ROOKIE_MIN_JOINT=0.60   (handicap / double chance only)
# FB_HUSTLER_LEGS=8 FB_HUSTLER_MIN_PROB=0.84 FB_HUSTLER_MIN_JOINT=0.30
# FB_HIGH_ROLLER_TARGET_ODDS=10  FB_HIGH_ROLLER_MIN_PROB=0.80  FB_HIGH_ROLLER_LEAGUE_CAP=3
# FB_LEGEND_TARGET_ODDS=100      FB_LEGEND_MIN_PROB=0.70  FB_LEGEND_MAX_LEG_ODDS=1.40  FB_LEGEND_LEAGUE_CAP=4

# Reject QuestPay webhooks that are not signed (x-questpay-signature). Unsigned ones are otherwise only credited after QuestPay confirms the reference.
# STRICT_WEBHOOK=false
